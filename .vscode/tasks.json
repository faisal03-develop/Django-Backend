{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Django + Tailwind (hot reload)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "tailwind",
                "start"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Tailwind: watch CSS only",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "tailwind",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
